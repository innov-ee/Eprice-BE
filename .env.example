# ==============================================================================
# Environment Configuration Template for Eprice-BE
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=0.0.0.0

# Upstream Market Data APIs
ENTSOE_API_KEY=your_entsoe_security_token_here

# Local Cache Directory
CACHE_DIR=/app/data

# Security - Mobile Client Bootstrap Key
# Shared secret between backend and mobile apps to fetch ephemeral operational keys
BOOTSTRAP_KEY=sec_boot_9f7a8b3e1c2d4f5082e6a1789c3b4a2e

# Security - Stateless HMAC Key Derivation Master Secret
# Cryptographically strong secret used to deterministically derive rotating operational keys
# Any string works but better use smth like `openssl rand -hex 32` to generate it.
MASTER_SECRET=9a4f6b1c8d3e2a0f7e5b8c9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b

# Security - Admin HTTP Basic Authentication Credentials
# Grants access to /monitor, /monitor.html, /api/cache/clear, and direct API endpoints
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_random_secure_password_here
